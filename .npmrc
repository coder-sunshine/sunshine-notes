# -----------------------------------------------------------
# 核心配置：解决依赖找不到的问题 (Monorepo 必备)
# -----------------------------------------------------------
# 开启“羞耻提升”。
# 作用：把所有依赖都“提升”到根目录的 node_modules 下，模拟 npm/yarn 的扁平化结构。
# 为什么：默认的 pnpm 太严格了，很多工具（如 ESLint, Astro 插件）找不到深层依赖会报错。
# 开启这个能解决 99% 的“Module not found”问题。
shamefully-hoist=true

# -----------------------------------------------------------
# 自动安装 Peer Dependencies
# -----------------------------------------------------------
# 作用：自动安装缺失的对等依赖。
# 为什么：Vue 和 React 的插件生态中，经常会有复杂的 peerDependency 关系。
# 开启它可以防止终端出现一大堆“missing peer”的黄色警告。
auto-install-peers=true
