{
  "version": "0.2",
  "language": "en",
  "import": ["@cspell/dict-lorem-ipsum/cspell-ext.json"],
  "dictionaries": ["words"],
  "dictionaryDefinitions": [
    {
      "name": "words",
      "path": "./.cspell/words.txt",
      "addWords": true
    }
  ],
  "ignorePaths": [".claude", "node_modules", "dist", "build", ".astro", "pnpm-lock.yaml", "*.min.js", "*.min.css"],
  "ignoreRegExpList": ["\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}\\b"]
}
