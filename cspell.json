{
  "version": "0.2",
  "language": "en",
  "import": ["@cspell/dict-lorem-ipsum/cspell-ext.json"],
  "dictionaries": ["words"],
  "dictionaryDefinitions": [
    {
      "name": "words",
      "path": "./.cspell/words.txt",
      "addWords": true
    }
  ],
  "ignorePaths": ["apps/docs/src/content/docs/backend/c/**/*"],
  "ignoreRegExpList": ["\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}\\b"]
}
